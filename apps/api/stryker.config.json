{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-core.schema.json",
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.pure.config.ts" },
  "mutate": [
    "src/http/csv.ts",
    "src/http/cursor.ts",
    "src/modules/auth/tokens.ts",
    "src/modules/admin/technologies.ts:25-60"
  ],
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress"],
  "tempDirName": ".stryker-tmp",
  "thresholds": { "high": 85, "low": 70, "break": 60 }
}
