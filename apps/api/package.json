{
  "name": "@qb/api",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/seed/run.ts",
    "seed:prod": "node dist/seed/run.js --if-empty"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "7.10.0",
    "swagger-ui-dist": "5.33.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-dist": "3.30.6",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "vitest": "5.0.4"
  }
}
