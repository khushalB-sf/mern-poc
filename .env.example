# Copy to .env and edit. .env is git-ignored.
# Keep POSTGRES_PASSWORD URL-safe (letters/digits): it is embedded in DATABASE_URL.
POSTGRES_USER=qb
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=qb
# Host ports. 5436 avoids other local Postgres containers; change if taken (see docs/docker.md).
POSTGRES_HOST_PORT=5436
API_HOST_PORT=4000
WEB_HOST_PORT=3000

# Used when running the API on the host (npm run dev). Inside compose the api builds its own URL with host "db".
DATABASE_URL=postgresql://qb:change-me-locally@localhost:5436/qb

# DEV ONLY placeholders so `docker compose up` works out of the box.
# Replace with `openssl rand -base64 48` (two different values) for anything shared.
# The API refuses to start with these when COOKIE_SECURE=true.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-987654321

ALLOWED_ORIGINS=http://localhost:3000
# Set true only when served over https (Safari drops Secure cookies on http://localhost).
COOKIE_SECURE=false
# Seed demo data on first start when the database is empty.
SEED_ON_START=true
SEED_PASSWORD=Passw0rd!demo

# Web build option: show the Demo accounts panel on the login page. Clicking one fills in the email AND the
# demo password, which is then in the web bundle. Set false for anything shared.
VITE_SHOW_DEMO_ACCOUNTS=true
